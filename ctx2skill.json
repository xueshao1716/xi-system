    "caveman": {
      "id": "caveman",
      "name": "原始人压缩",
      "version": 1,
      "layer": "User",
      "description": "把长文档/代码/对话压缩成最少token的摘要，只留核心信息。像原始人一样只说关键的几个字。目标：压缩75% token。",
      "index_summary": "Caveman: 压缩75% token，只留核心",
      "trigger_conditions": [
        "上下文快满了需要压缩",
        "长文档需要摘要",
        "代码审查需要精简输出"
      ],
      "body_steps": [
        "1. 识别核心信息：目标、结论、行动项",
        "2. 删除修饰词、重复、背景介绍",
        "3. 合并同类项，用缩写",
        "4. 保留文件路径/行号等可定位信息",
        "5. 压缩后检查：信息是否完整？能恢复原意？"
      ],
      "body_appendix": [
        "压缩不等于丢失信息",
        "关键数字、路径、行号不能丢",
        "宁可多保留一个词也不要少"
      ],
      "examples": [
        "例：500行代码审查→'agent_loop.rs:342 borrow冲突，需拆lifetime，已试3方案均fail'",
        "例：10篇论文摘要→'ECC: 4问门禁+零发现合法。Nature: 开放评分逆转幻觉。Self-Harness: 双验证不退步'"
      ],
      "tags": [
        "compression",
        "token-saving",
        "efficiency",
        "summarization"
      ],
