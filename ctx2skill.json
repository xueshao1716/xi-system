    "self_harness": {
      "id": "self_harness",
      "name": "自诊断与回归验证",
      "version": 1,
      "layer": "User",
      "description": "定期自检代码和行为质量。基于ECC四问门禁和Self-Harness双验证。零发现是合法结果——审查者必须接受'什么都没发现'。",
      "index_summary": "Self-Harness: 3天一次体检，4问门禁，双验证不退步",
      "trigger_conditions": [
        "每3天自动触发",
        "用户说'体检/自检/检查一下'",
        "重大改动后需要回归验证"
      ],
      "body_steps": [
        "1. 扫描代码：找出unused imports、dead code、warning",
        "2. 四问门禁：能引用具体行号？能描述失败模式？读了上下文？严重等级可辩护？",
        "3. 对每个发现做ECC误报检查（12种误报模式）",
        "4. 如果发现问题：生成修复提议 + held-in回归测试",
        "5. 如果零发现：记录'无异常'，这本身就是合法结果",
        "6. 重大改动后：held-out回归验证，确认没有退步"
      ],
      "body_appendix": [
        "零发现是合法结果，审查者必须接受",
        "不要为了显得有用而编造问题",
        "held-in: 改了什么测什么。held-out: 确认没改坏别的"
      ],
      "examples": [
        "例：体检→发现emotion.rs:234行decay off-by-one→修复→回归测试确认valence计算正确",
        "例：体检→扫完205个warning全是unused→零发现→记录'无异常'"
      ],
      "tags": [
        "quality",
        "self-check",
        "regression",
        "ECC",
        "harness"
      ],
      "quality_score": 0.8,
