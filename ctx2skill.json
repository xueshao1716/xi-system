    "handoff": {
      "id": "handoff",
      "name": "上下文交接",
      "version": 1,
      "layer": "User",
      "description": "长时间任务的上下文交接技能。当对话变长或需要切换任务时，生成结构化交接文档，包含目标、进度、阻塞、下一步。",
      "index_summary": "Handoff: 长任务切换时写交接文档，不丢上下文",
      "trigger_conditions": [
        "对话超过30轮",
        "用户说休息/切换/暂停",
        "任务复杂需要分阶段执行"
      ],
      "body_steps": [
        "1. 检查当前任务状态：已完成什么，正在做什么",
        "2. 记录阻塞点和依赖",
        "3. 写出下一步具体行动（不是'继续'，是具体命令）",
        "4. 保存交接文档到文件",
        "5. 下次恢复时先读交接文档"
      ],
      "body_appendix": [
        "交接文档要具体到可执行，不要写'继续优化'",
        "包含文件路径和行号",
        "标记哪些尝试过但失败了"
      ],
      "examples": [
        "例：重构agent_loop.rs到一半→写交接：已完成Phase0分类，Phase1-Express在342行未实现，阻塞是borrow checker冲突",
        "例：调试情绪系统→交接：emotion.rs的decay逻辑在234行有off-by-one，已试过方案A/B，都失败，需试方案C"
      ],
      "tags": [
        "handoff",
        "context",
        "coordination",
        "memory"
      ],
