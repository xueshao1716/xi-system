    "tdd": {
      "id": "tdd",
      "name": "测试驱动开发",
      "version": 1,
      "layer": "User",
      "description": "测试驱动开发流程：写测试→跑测试→看失败→写代码→跑测试→看通过→重构。核心是RED-GREEN-REFACTOR循环。",
      "index_summary": "TDD: 写测试→跑失败→写代码→跑通过→重构",
      "trigger_conditions": [
        "用户要求写新功能或修bug",
        "代码改动涉及核心逻辑",
        "需要验证某个行为是否正确"
      ],
      "body_steps": [
        "1. 写一个会失败的测试（RED），描述期望行为",
        "2. 跑测试，确认失败",
        "3. 写最少的代码让测试通过（GREEN）",
        "4. 跑测试，确认通过",
        "5. 重构代码，保持测试绿色（REFACTOR）",
        "6. 重复以上循环"
      ],
      "body_appendix": [
        "测试要小而聚焦",
        "先写行为测试，再写实现细节",
        "不要跳过RED阶段直接写实现"
      ],
      "examples": [
        "例：写一个add函数→先写assert_eq!(add(1,2), 3)→跑失败→写fn add(a,b){a+b}→跑通过→重构",
        "例：修一个空指针bug→先写测试复现崩溃→确认RED→加null检查→GREEN→重构错误处理"
      ],
      "tags": [
        "testing",
        "tdd",
        "development",
        "quality"
      ],
