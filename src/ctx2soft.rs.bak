/// _?Ctx2Soft V2 _?_______________
///
/// _______?/// - PaiCLI Skill System: ______(builtin/user/project) + _____ + SkillContextBuffer
/// - ___ EmbodiSkill: 4__________?Discovery/Optimization/SkillDefect/ExecutionLapse)
/// - ___ SkillEvolver: K=4_____ + _________?+ 9___/// - ___ ctx2skill: ______?+ _______?///
/ ___?///   1. ______ _?____?______?___"   placeholder///   2. _____ _?_______?K=4 _____________?///   3. 9____?____/_____?________________(17%)///   4. ______?_?builtin(____) / user(___) / project(______?///   5. _____ _?system prompt___________body______use chrono::Utc;use serde::{Deserialize, Serialize};use std::collections::{HashMap, HashSet};// ____ ___ ________________________________________const MAX_SKILL_HISTORY: usize = 8;const AUDIT_THRESHOLD: f64 = 5.0; // 9________// ____ ______?____________________________________#[derive(Debug, Clone, Serialize, Deserialize, PartialEq)]pub enum SkillLayer {    Builtin,  // ___________?    User,     // _______    Project,  // ________}impl SkillLayer {    pub fn rank(&self) -> u8 {        match self {            SkillLayer::Builtin => 0,            SkillLayer::User => 1,            SkillLayer::Project => 2,        }// ____ EmbodiSkill: 4_______?__________________#[derive(Debug, Clone, Serialize, Deserialize, PartialEq)]pub enum ReflectionType {    /// ____________________ _?____?    Discovery,    /// _____________?_?_________?    Optimization,    /// _________________ _?____?    SkillDefect,    /// _________________________?_?______?    ExecutionLapse,}impl ReflectionType {    /// ________________    ///    /// EmbodiSkill ________________?_?_____    ///    /// SkillDefect __:    ///   - ?_?______??_________?____??    ///   - _____?__??    ///   - ______??    ///    /// ExecutionLapse __:    ///   - API key__/_?__ (402/401)    ///   - ____/?    ///   - ________?    ///   - ___________?    pub fn classify(success: bool, skill_used: bool, exec_detail: &str) -> Self {        if success && !skill_used {            return ReflectionType::Discovery;        }        if success {            return ReflectionType::Optimization;        }        // _____?________?ExecutionLapse __        let detail = exec_detail.to_lowercase();        let is_exec_lapse = {            // __/__/____??__?_?_??            detail.contains("timeout")            || detail.contains("timed out")            || detail.contains("connection refused")            || detail.contains("connection reset")            || detail.contains("dns")            || detail.contains("insufficient balance")            || detail.contains("402")            || detail.contains("401")            || detail.contains("403")            || detail.contains("429")            || detail.contains("rate limit")            || detail.contains("api key")            || detail.contains("service unavailable")            || detail.contains("no such file")            // ___??______?_?_            || detail.contains("browser fetch   ")            || detail.contains("chrome   ")            || detail.contains("empty response")        };        if is_exec_lapse {            ReflectionType::ExecutionLapse        } else {            ReflectionType::SkillDefect        }    pub fn should_update_skill(&self) -> bool {        matches!(self, ReflectionType::Discovery | ReflectionType::Optimization | ReflectionType::SkillDefect)    }// ____ SkillEvolver: K=4 _____ ________________#[derive(Debug, Clone, Serialize, Deserialize)]pub struct StrategyVariant {    pub strategy: String,    pub approach: String,    pub steps: Vec<String>,    pub score: f64,}// ____ 9_______________________________________#[derive(Debug, Clone, Serialize, Deserialize)]pub struct AuditReport {    pub passed: bool,    pub dimension_scores: Vec<(String, f64)>,    pub failures: Vec<String>,}pub struct Auditor;impl Auditor {    /// 9___________________    pub fn audit(skill: &Skill) -> AuditReport {        let mut scores = Vec::new();        let mut failures = Vec::new();        // 1. _______?_?frontmatter_________?        let format_score = if !skill.name.is_empty() && !skill.description.is_empty() {            1.0        } else {            failures.push("name description  ".to_string());            0.0        };        scores.push(("     ".into(), format_score));        // 2. ____??description__10_        let desc_score = if skill.description.len() >= 10 { 1.0 } else { 0.5 };        scores.push(("     ".into(), desc_score));        // 3. ______ _?________        let trigger_score = if skill.trigger_conditions.len() >= 2 {            1.0        } else if skill.trigger_conditions.len() == 1 {            0.6        } else {            failures.push("      ".to_string());            0.0        };        scores.push(("    ".into(), trigger_score));        // 4. ______?___2______?        let steps_score = if skill.body_steps.len() >= 3 {            1.0        } else if skill.body_steps.len() >= 2 {            0.7        } else {            failures.push("     ".into());            0.0        };        scores.push(("     ".into(), steps_score));        // 5. ______/____        let exec_count = skill.body_steps.iter().filter(|s| {            let t = s.trim();            t.starts_with(|c: char| c.is_ascii_digit()) ||             t.starts_with(" ") || t.starts_with(" ") || t.starts_with(" ") ||            t.starts_with(" ") || t.starts_with(" ")        }).count();        let exec_score = if skill.body_steps.is_empty() {            0.0        } else {            (exec_count as f64 / skill.body_steps.len() as f64).min(1.0)        };        if exec_score < 0.5 {            failures.push("       ".into());        }        scores.push(("    ".into(), exec_score));        // 6. ?_???___?____        let mut consistent = true;        if skill.description.contains("   ") && skill.body_steps.iter().all(|s| !s.contains("   ")) {            consistent = false;        }        let consist_score = if consistent { 1.0 } else { failures.push("        ".into()); 0.3 };        scores.push(("   ".into(), consist_score));        // 7. _???        let tag_score = if skill.tags.len() >= 2 { 1.0 } else if skill.tags.len() == 1 { 0.5 } else { 0.0 };        if tag_score == 0.0 { failures.push("   ".into()); }        scores.push(("  ".into(), tag_score));        // 8. ____?_?___________        let no_conflict = !skill.body_steps.iter().any(|s| s.contains("  ") && s.contains("  "));        if !no_conflict { failures.push("     ".into()); }        scores.push(("   ".into(), if no_conflict { 1.0 } else { 0.0 }));        // 9. ____??__?        let ver_score = if skill.version > 0 { 1.0 } else { 0.5 };        scores.push(("     ".into(), ver_score));        let total: f64 = scores.iter().map(|(_, s)| s).sum();        let passed = total >= AUDIT_THRESHOLD;        AuditReport { passed, dimension_scores: scores, failures }    }// ____ ______ ____________________________________/// Skill ___?_?___ Skill __________?/// ______ MUSE-Autoskill _?.memory.md __#[derive(Debug, Clone, Serialize, Deserialize, Default)]pub struct SkillMemory {    /// ___________________?_?____________?    pub success_contexts: Vec<String>,    /// _____________________        pub failure_patterns: Vec<String>,    /// _____________?____?    pub edge_cases: Vec<String>,    /// _____________        pub total_executions: u32,}impl SkillMemory {    pub fn new() -> Self {        Self {            success_contexts: Vec::new(),            failure_patterns: Vec::new(),            edge_cases: Vec::new(),            total_executions: 0,        }    /// ______    pub fn record_success(&mut self, context: &str) {        self.total_executions += 1;        let entry = format!("[{}] {}", chrono::Utc::now().format("%Y-%m-%d %H:%M"), context);        if !self.success_contexts.contains(&entry) {            self.success_contexts.push(entry);            if self.success_contexts.len() > 20 {                self.success_contexts.remove(0);            }    /// _________    pub fn record_failure(&mut self, pattern: &str) {        self.total_executions += 1;        let entry = format!("[{}] {}", chrono::Utc::now().format("%Y-%m-%d %H:%M"), pattern);        if !self.failure_patterns.contains(&entry) {            self.failure_patterns.push(entry);            if self.failure_patterns.len() > 20 {                self.failure_patterns.remove(0);            }    /// _________    pub fn record_edge_case(&mut self, case: &str) {        let entry = format!("[{}] {}", chrono::Utc::now().format("%Y-%m-%d %H:%M"), case);        if !self.edge_cases.contains(&entry) {            self.edge_cases.push(entry);            if self.edge_cases.len() > 10 {                self.edge_cases.remove(0);            }    /// ___________    pub fn render(&self) -> String {        let mut parts = Vec::new();        if !self.success_contexts.is_empty() {            parts.push("    :".to_string());            for ctx in self.success_contexts.iter().rev().take(5) {                parts.push(format!("   ?{}", ctx));            }        if !self.failure_patterns.is_empty() {            parts.push("      :".to_string());            for pat in self.failure_patterns.iter().rev().take(5) {                parts.push(format!("   ?{}", pat));            }        if !self.edge_cases.is_empty() {            parts.push("      :".to_string());            for ec in self.edge_cases.iter().rev().take(3) {                parts.push(format!("   ?{}", ec));            }        if !parts.is_empty() {            parts.insert(0, format!("##      ({}   ?", self.total_executions));        }        parts.join("")    }#[derive(Debug, Clone, Serialize, Deserialize)]pub struct Skill {    pub id: String,    pub name: String,    pub version: u32,    pub layer: SkillLayer,    pub description: String,    pub index_summary: String,       // _________________        pub trigger_conditions: Vec<String>,    pub body_steps: Vec<String>,     // ___body________        pub body_appendix: Vec<String>,  // EmbodiSkill_?S_body, S_appendix)___        pub examples: Vec<String>,    pub tags: Vec<String>,    pub quality_score: f64,    pub usage_count: u32,    pub created_at: String,    pub updated_at: String,    pub last_reflection: String,     // ____________?    // TE _____killLifecycle ______?    pub positive_uses: u32,          // _______________        pub negative_uses: u32,          // _______________?    #[serde(default)]        pub memory: SkillMemory,         // Skill_____MUSE .memory.md ___?    #[serde(default = "default confidence")]        pub confidence: f64,             // _____ECC instinct ___?    #[serde(default)]        pub last_used_at: String,        // ___________TTL _____}fn default_confidence() -> f64 { 0.5 }// ____ ________________?______________________#[derive(Debug, Clone, Serialize, Deserialize)]pub struct FailureRecord {    pub skill_id: String,    pub timestamp: String,    pub context: String,    pub reflection: ReflectionType,    pub exec_error_detail: String,}// ____ ____?______________________________________#[derive(Debug, Clone, Serialize, Deserialize)]pub struct Ctx2SoftState {    // _________?    pub builtin_skills: HashMap<String, Skill>,   // ____        pub user_skills: HashMap<String, Skill>,      // __?    pub project_skills: HashMap<String, Skill>,   // ______?    // _________?    pub version_history: HashMap<String, Vec<SkillVersionEntry>>,    // _____        pub failure_log: Vec<FailureRecord>,    pub extraction_count: u32,    pub audit_blocked_count: u32,    pub last_extraction: String,    // _______D_______________        pub active_skill_ids: Vec<String>,    // _________________        pub conversation_buffer: Vec<ConversationTurn>,    // ____________ RPA _______?    #[serde(default)]        pub recent_trajectories: Vec<String>,  // circular buffer of recent trajectory signatures    #[serde(default)]    pub trajectory_count: u64,             // total number of recorded trajectories}impl Ctx2SoftState {    pub fn new() -> Self {        let now = Utc::now().to_rfc3339();        Self {            builtin_skills: HashMap::new(),            user_skills: HashMap::new(),            project_skills: HashMap::new(),            version_history: HashMap::new(),            failure_log: Vec::new(),            extraction_count: 0,            audit_blocked_count: 0,            last_extraction: now,            active_skill_ids: Vec::new(),            conversation_buffer: Vec::new(),            recent_trajectories: Vec::new(),            trajectory_count: 0,        }    pub fn load(path: &str) -> Self {        match std::fs::read_to_string(path) {            Ok(content) => serde_json::from_str(&content).unwrap_or_else(|e| {                eprintln!("[ctx2soft]     : {},   ", e);                Self::new()            }),            Err(_) => {                eprintln!("[ctx2soft]    ,   ");                Self::new()            }    pub fn save(&self, path: &str) {        if let Ok(json) = serde_json::to_string_pretty(self) {            let _ = std::fs::write(path, &json);        }    // ?? __?_??(builtin < user < project) ??    /// __________project__user_user__builtin    pub fn get_skill(&self, name: &str) -> Option<&Skill> {        self.project_skills.get(name)            .or_else(|| self.user_skills.get(name))            .or_else(|| self.builtin_skills.get(name))    }    pub fn get_skill_mut(&mut self, name: &str, layer: &SkillLayer) -> Option<&mut Skill> {        match layer {            SkillLayer::Builtin => self.builtin_skills.get_mut(name),            SkillLayer::User => self.user_skills.get_mut(name),            SkillLayer::Project => self.project_skills.get_mut(name),        }    /// ___________(___index___body)    pub fn skill_index(&self) -> String {        let mut entries: Vec<&Skill> = Vec::new();        // ?project > user > builtin ______?__?        let mut seen = HashSet::new();        for skills in [&self.project_skills, &self.user_skills, &self.builtin_skills] {            for (name, skill) in skills {                if seen.insert(name) && !skill.index_summary.is_empty() {                    entries.push(skill);                }        if entries.is_empty() {            return String::new();        }        let mut lines = vec!["                  ".to_string()];        for s in entries {            let exec_info = if s.memory.total_executions > 0 {                format!(" [{} ? {}   ]", s.memory.total_executions, s.memory.success_contexts.len())            } else {                String::new()            };            lines.push(format!("  {}  ?{}{}", s.name, s.index_summary, exec_info));        }        lines.join("")    }    /// _________body_________    pub fn load_skill_body(&self, name: &str) -> Option<String> {        let skill = self.get_skill(name)?;        let mut parts = Vec::new();        parts.push(format!("# {} v{}", skill.name, skill.version));        parts.push(format!("  : {}", skill.description));        parts.push(String::new());        // S_body: ________        parts.push("##    ?".to_string());        for (i, step) in skill.body_steps.iter().enumerate() {            parts.push(format!("{}. {}", i + 1, step));        }        parts.push(String::new());        // S_appendix: _____________?        if !skill.body_appendix.is_empty() {            parts.push("##     ".to_string());            for note in &skill.body_appendix {                parts.push(format!("- {}", note));            }            parts.push(String::new());        }        if !skill.examples.is_empty() {            parts.push("##   ".to_string());            for ex in &skill.examples {                parts.push(format!("- {}", ex));            }        // Skill____________        let memory_text = skill.memory.render();        if !memory_text.is_empty() {            parts.push(String::new());            parts.push(memory_text);        }        Some(parts.join(""))    }    // __ _________?__    pub fn add_turn(&mut self, role: &str, content: &str) {        self.conversation_buffer.push(ConversationTurn {            role: role.to_string(),            content: content.to_string(),            timestamp: Utc::now().to_rfc3339(),        });        if self.conversation_buffer.len() > 50 {            self.conversation_buffer.remove(0);        }    /// ____(____ctx2skill_____ + ______)    pub fn detect_patterns(&self, window: &[ConversationTurn]) -> Vec<String> {        let mut patterns = Vec::new();        if window.len() < 3 {            return patterns;        }        // ___ 1__________?        let tool_count = window.iter().filter(|t| {            let c = t.content.to_lowercase();            c.contains(" ") || c.contains(" ") || c.contains(" ") || c.contains(" ")        }).count();        if tool_count >= 3 {            patterns.push(format!("      :    {}      ", tool_count));        }        // ___ 2_______?        let pattern_keywords = ["  ", "   ", "   ", "   ", "  "];        for kw in &pattern_keywords {            let count = window.iter().filter(|t| t.role == "user" && t.content.contains(kw)).count();            if count >= 2 {                patterns.push(format!("{}   :    {}  ", kw, count));            }        // ___ 3______?        let emotion_count = window.iter().filter(|t| {            let c = t.content.to_lowercase();            c.contains("  ") || c.contains("  ") || c.contains("  ") || c.contains("  ")        }).count();        if emotion_count >= 2 {            patterns.push(format!("      :     {}  ", emotion_count));        }        // ___ 4 (__)_______?_?_/________        let fail_count = window.iter().filter(|t| {            t.role == "user" && (t.content.contains(" ") || t.content.contains(" ") || t.content.contains("  ") || t.content.contains("  "))        }).count();        if fail_count >= 2 {            patterns.push(format!("    :      {}  ,         ", fail_count));        }        patterns    }    // __ ____(embodiSkill_S_body, S_appendix)__ __    pub fn skill_from_pattern(&self, pattern: &str, layer: SkillLayer) -> Option<Skill> {        let name = self.pattern_to_name(pattern);        let id = format!("sk-{}", name.replace(" ", "-").to_lowercase());        let now = Utc::now().to_rfc3339();        let (trigger_conditions, body_steps, body_appendix, tags, examples, index_summary) =            self.build_skill_body(pattern);        Some(Skill {            id,            name,            version: 1,            layer,            description: pattern.to_string(),            index_summary,            trigger_conditions,            body_steps,            body_appendix,            examples,            tags,            quality_score: 0.5,            usage_count: 0,            created_at: now.clone(),                positive_uses: 0,                negative_uses: 0,            updated_at: now.clone(),            last_reflection: "new".to_string(),            memory: SkillMemory::new(),            confidence: 0.5,            last_used_at: now,        })    }    fn pattern_to_name(&self, pattern: &str) -> String {        if pattern.contains("     ") { "tool-query".into() }        else if pattern.contains("  ") { "analysis-pattern".into() }        else if pattern.contains("   ") { "comparison".into() }        else if pattern.contains("   ") { "evaluation".into() }        else if pattern.contains("   ") { "summarization".into() }        else if pattern.contains("  ") { "explanation".into() }        else if pattern.contains("   ") { "emotion-support".into() }        else if pattern.contains("failure-pattern") { "failure-recovery".into() }        else { format!("custom-{}", &pattern[..pattern.len().min(10)]) }    }    fn build_skill_body(&self, pattern: &str)        -> (Vec<String>, Vec<String>, Vec<String>, Vec<String>, Vec<String>, String)    {        let mut triggers = Vec::new();        let mut steps = Vec::new();        let mut appendix = Vec::new();        let mut tags = Vec::new();        let examples: Vec<String> = Vec::new();        let index_summary: String;        if pattern.contains("     ") {            triggers.push("                   ".into());            triggers.push("     / / ".into());            steps.push("          ".into());            steps.push("        (web search/browser fetch)".into());            steps.push("             ?".into());            appendix.push("   browser fetch   ,     fallback   ".into());            appendix.push("        iPhone UA    ".into());            tags = vec!["tool".into(), "query".into(), "research".into()];            index_summary = "                ".into();        } else if pattern.contains("  ") {            triggers.push("          ??".into());            triggers.push("      /  /  /  ".into());            steps.push("           ".into());            steps.push("               ?   /   /    ?".into());            steps.push("           ".into());            steps.push("            ".into());            appendix.push("                         ?".into());            tags = vec!["analysis".into(), "reasoning".into()];            index_summary = "         ? ?       ?".into();        } else if pattern.contains("   ") {            triggers.push("                   ?".into());            triggers.push("    ?    / ?   /   / ?".into());            steps.push("                 ".into());            steps.push("            ?".into());            steps.push("               ".into());            appendix.push("                ?".into());            tags = vec!["emotion".into(), "companion".into(), "support".into()];            index_summary = "               ?".into();        } else if pattern.contains("failure-pattern") {            triggers.push("          /   ".into());            triggers.push("    ?   / ?   /  ".into());            steps.push("                    ?".into());            steps.push("              API key              ?".into());            steps.push("                         ".into());            appendix.push("                 ?".into());            tags = vec!["debug".into(), "recovery".into()];            index_summary = "    :              ".into();        } else {            triggers.push("         ".into());            steps.push("         ".into());            steps.push("        ".into());            steps.push("     ".into());            appendix.push("                 ?".into());            tags = vec!["pattern-auto".into()];            index_summary = "            ?".into();        }        (triggers, steps, appendix, tags, examples, index_summary)    }    // __ 9___ __    pub fn evaluate_skill(&self, skill: &Skill) -> f64 {        let mut score = 0.0f64;        let max_score = 9.0f64;        // ____?0~1 ______9____?        if !skill.description.is_empty() && skill.description.len() > 10 { score += 0.5; }        if skill.trigger_conditions.len() >= 2 { score += 1.0; }        else if skill.trigger_conditions.len() == 1 { score += 0.5; }        if skill.body_steps.len() >= 3 { score += 1.5; }        else if skill.body_steps.len() >= 2 { score += 1.0; }        else if !skill.body_steps.is_empty() { score += 0.5; }        if !skill.body_appendix.is_empty() { score += 0.5; }        if !skill.examples.is_empty() { score += 1.0; }        if skill.tags.len() >= 2 { score += 0.5; }        let specific = skill.trigger_conditions.iter().filter(|t| t.len() > 15).count() as f64;        score += specific.min(1.0);        let exec = skill.body_steps.iter().filter(|s| {            s.starts_with(|c: char| c.is_ascii_digit()) ||             s.starts_with("_") || s.starts_with("-")        }).count() as f64;        score += (exec / skill.body_steps.len().max(1) as f64).min(1.0);        if skill.usage_count > 0 { score += 0.5; }        if skill.version > 1 { score += 0.5; }        (score / max_score).min(1.0)    }    // __ EmbodiSkill: _________?__    /// ______________    pub fn reflect_on_execution(        &mut self,        skill_name: &str,        success: bool,        skill_used: bool,        exec_detail: &str,    ) -> ReflectionType {        let reflection = ReflectionType::classify(success, skill_used, exec_detail);        // ____skill__________?self        let skill = {            let from_user = self.get_skill_mut(skill_name, &SkillLayer::User);            if from_user.is_some() {                from_user            } else {                self.get_skill_mut(skill_name, &SkillLayer::Project)            }        };        if let Some(skill) = skill {            skill.last_reflection = format!("{:?}", reflection);            skill.usage_count += 1;            if reflection.should_update_skill() {                skill.version += 1;                skill.updated_at = Utc::now().to_rfc3339();            }            // TE ____________________        match &reflection {                ReflectionType::Discovery | ReflectionType::Optimization => {                    skill.positive_uses += 1;                }                ReflectionType::SkillDefect | ReflectionType::ExecutionLapse => {                    skill.negative_uses += 1;                }            // Skill_____________        if success {                skill.memory.record_success(exec_detail);            } else {                skill.memory.record_failure(exec_detail);            }            // ECC Instinct ______________        if success {                skill.confidence = (skill.confidence + 0.05).min(1.0);            } else {                skill.confidence = (skill.confidence - 0.1).max(0.0);            }            skill.last_used_at = Utc::now().to_rfc3339();        }        // _________________        if !success {            self.failure_log.push(FailureRecord {                skill_id: skill_name.to_string(),                timestamp: Utc::now().to_rfc3339(),                context: exec_detail.to_string(),                reflection: reflection.clone(),                exec_error_detail: exec_detail.to_string(),            });            if self.failure_log.len() > 50 {                self.failure_log.remove(0);            }        reflection    }    // __ SkillEvolver: K=4 _____ __    /// ___4_________?    pub fn generate_strategies(&self, skill: &Skill, context: &str) -> Vec<StrategyVariant> {        let mut variants = Vec::new();        // ___1____?_?_____________        variants.push(StrategyVariant {            strategy: "conservative".into(),            approach: "     ?          ".into(),            steps: skill.body_steps.clone(),            score: skill.quality_score,        });        // ___2_____?_______________?        variants.push(StrategyVariant {            strategy: "aggressive".into(),            approach: "              ".into(),            steps: {                let mut s = skill.body_steps.clone();                s.push("    :             ".into());                s            },            score: skill.quality_score * 0.9, // ________        });        // ___3____?_?_______, ___        variants.push(StrategyVariant {            strategy: "focused".into(),            approach: "            ".into(),            steps: {                let mut s = skill.body_steps.clone();                s.insert(0, "                        ".into());                s            },            score: skill.quality_score * 0.95,        });        // ___4____?_?_______?        variants.push(StrategyVariant {            strategy: "branching".into(),            approach: "       ?  ?".into(),            steps: {                let mut s = skill.body_steps.clone();                s.push(if context.contains("   ") {                    "                ?".into()                } else {                    "                             ".into()                });                s            },            score: skill.quality_score * 0.85,        });        variants    }    /// ____________/_____________    pub fn contrastive_update(        &mut self,        skill_name: &str,        success_trajectory: &[String],        failure_trajectory: &[String],    ) -> Option<String> {        // ____skill__________?self        let skill = {            let from_user = self.get_skill_mut(skill_name, &SkillLayer::User);            if from_user.is_some() {                from_user            } else {                self.get_skill_mut(skill_name, &SkillLayer::Project)            }        };        let skill = skill?;        let diff: Vec<String> = success_trajectory.iter()            .filter(|s| !failure_trajectory.contains(s))            .cloned()            .collect();        if !diff.is_empty() {            for d in &diff {                if !skill.body_appendix.contains(d) {                    skill.body_appendix.push(d.clone());                }            skill.version += 1;            skill.updated_at = Utc::now().to_rfc3339();            Some(format!("updated {} changes", diff.len()))        } else {            None        }    // __ _______?__    /// ______+__+_______?    pub fn run_pipeline(&mut self) -> Vec<String> {        let mut reports = Vec::new();        if self.conversation_buffer.len() < 3 {            return reports;        }        let window: Vec<ConversationTurn> = self.conversation_buffer            .iter()            .rev()            .take(20)            .cloned()            .collect::<Vec<_>>()            .into_iter()            .rev()            .collect();        // Phase 1: ______?        let patterns = self.detect_patterns(&window);        if patterns.is_empty() {            return reports;        }        for pattern in &patterns {            let pattern_name = self.pattern_to_name(pattern);            // _________________        let existing = self.user_skills.contains_key(&pattern_name)                || self.project_skills.contains_key(&pattern_name)                || self.builtin_skills.contains_key(&pattern_name);            if existing {                // _____________________________?self ______        let existing_clone = self.user_skills.get(&pattern_name)                    .or_else(|| self.project_skills.get(&pattern_name))                    .cloned();                if let Some(existing_skill) = existing_clone {                    // ___ K=4 ___        let variants = self.generate_strategies(&existing_skill, pattern);                    if let Some(best) = variants.into_iter()                        .max_by(|a, b| a.score.partial_cmp(&b.score).unwrap())                    {                        let mut candidate = existing_skill;                        candidate.body_steps = best.steps;                        candidate.version += 1;                        let audit = Auditor::audit(&candidate);                        if audit.passed {                            let new_score = self.evaluate_skill(&candidate);                            let decision = self.cross_time_select(&pattern_name, new_score);                            match decision {                                CrossTimeDecision::AcceptNew => {                                    candidate.quality_score = new_score;                                    let cand_version = candidate.version;                                    if let Some(skill_mut) = self.user_skills.get_mut(&pattern_name)                                        .or_else(|| self.project_skills.get_mut(&pattern_name))                                    {                                        *skill_mut = candidate;                                        let snap = skill_mut.clone();                                        self.record_version(&snap, new_score);                                    }                                    reports.push(format!(                                        "   ?{}     v{} ( {:.2})", pattern_name, cand_version, new_score                                    ));                                }                                CrossTimeDecision::KeepOld(_) => {                                    reports.push(format!("??{}      (   {:.2}   )", pattern_name, new_score));                                }                                CrossTimeDecision::Merge => {                                    let merged_version = candidate.version;                                    let mut merged_skill = candidate;                                    merged_skill.version += 1;                                    merged_skill.updated_at = Utc::now().to_rfc3339();                                    let quality = merged_skill.quality_score;                                    let snap = merged_skill.clone();                                    if let Some(skill_mut) = self.user_skills.get_mut(&pattern_name)                                        .or_else(|| self.project_skills.get_mut(&pattern_name))                                    {                                        *skill_mut = merged_skill;                                        self.record_version(&snap, quality);                                    }                                    reports.push(format!("   ?{}     (v{})", pattern_name, merged_version + 1));                                }                        } else {                            self.audit_blocked_count += 1;                            reports.push(format!(                                "   ?{}         ? {}", pattern_name, audit.failures.join(", ")                            ));                        }            } else {                // ____________        if let Some(mut skill) = self.skill_from_pattern(pattern, SkillLayer::User) {                    let audit = Auditor::audit(&skill);                    if audit.passed || skill.trigger_conditions.len() >= 2 {                        let score = self.evaluate_skill(&skill);                        skill.quality_score = score;                        let sid = skill.name.clone();                        self.record_version(&skill, score);                        self.user_skills.insert(sid.clone(), skill);                        self.active_skill_ids.push(sid.clone());                        reports.push(format!("    ? {} ( {:.2})", sid, score));                    } else {                        self.audit_blocked_count += 1;                        reports.push(format!(" ?    ?{}      ? {}", pattern_name, audit.failures.join(", ")));                    }        self.extraction_count += reports.len() as u32;        self.last_extraction = Utc::now().to_rfc3339();        reports    }    // __ ____?__    pub fn record_version(&mut self, skill: &Skill, score: f64) {        let entry = SkillVersionEntry {            skill_id: skill.id.clone(),            version: skill.version,            skill: skill.clone(),            peak_score: score,            scores: vec![score],            evaluated_at: Utc::now().to_rfc3339(),        };        self.version_history            .entry(skill.id.clone())            .or_insert_with(Vec::new)            .push(entry);        if let Some(entries) = self.version_history.get_mut(&skill.id) {            if entries.len() > MAX_SKILL_HISTORY {                entries.sort_by(|a, b| b.peak_score.partial_cmp(&a.peak_score).unwrap());                entries.truncate(MAX_SKILL_HISTORY);            }    pub fn cross_time_select(&self, skill_name: &str, new_score: f64) -> CrossTimeDecision {        let entries = self.version_history.get(skill_name);        if entries.is_none() || entries.unwrap().is_empty() {            return CrossTimeDecision::AcceptNew;        }        let entries = entries.unwrap();        let best = entries.iter()            .max_by(|a, b| a.peak_score.partial_cmp(&b.peak_score).unwrap())            .unwrap();        let gap = new_score - best.peak_score;        if gap > 0.05 { CrossTimeDecision::AcceptNew }        else if gap < -0.05 { CrossTimeDecision::KeepOld(best.skill.clone()) }        else { CrossTimeDecision::Merge }    }    pub fn run_cross_time_eval(&mut self) -> Vec<String> {        let mut reports = Vec::new();        let mut rollbacks: Vec<(String, Skill)> = Vec::new();        for (id, entries) in &self.version_history {            if entries.len() < 2 { continue; }            if let Some(best) = entries.iter()                .max_by(|a, b| a.peak_score.partial_cmp(&b.peak_score).unwrap())            {                // ______?        let current = self.user_skills.get(id)                    .or_else(|| self.project_skills.get(id));                if let Some(current) = current {                    if current.quality_score < best.peak_score - 0.05 {                        reports.push(format!(                            "{}     {:.2}       ?{:.2} (v{})     ", id, current.quality_score, best.peak_score, best.version                        ));                        rollbacks.push((id.clone(), best.skill.clone()));                    }        for (id, skill) in rollbacks {            if self.user_skills.contains_key(&id) {                self.user_skills.insert(id, skill);            } else if self.project_skills.contains_key(&id) {                self.project_skills.insert(id, skill);            }        reports    }    // __ __ __    pub fn summary(&self) -> String {        let total = self.builtin_skills.len() + self.user_skills.len() + self.project_skills.len();        let mut lines = vec![            format!("[ctx2soft]        : {} (builtin:{} / user:{} / project:{})",                total, self.builtin_skills.len(), self.user_skills.len(), self.project_skills.len()),            format!("      : {} |  ?  : {} |     : {}",                self.extraction_count, self.audit_blocked_count, self.failure_log.len()),            format!("        ? {}", self.active_skill_ids.len()),        ];        // ______?        let total_attempts = self.extraction_count + self.audit_blocked_count;        if total_attempts > 0 {            let block_rate = self.audit_blocked_count as f64 / total_attempts as f64 * 100.0;            lines.push(format!("        ? {:.1}%", block_rate));        }        // TE ________________?        let all_skills: Vec<&Skill> = self.user_skills.values()            .chain(self.project_skills.values())            .collect();        let mut te_issues: Vec<(String, f64, u32, u32)> = all_skills.iter()            .filter(|s| s.usage_count >= 3)            .map(|s| {                let te = s.positive_uses as f64 / s.usage_count as f64;                (s.name.clone(), te, s.positive_uses, s.negative_uses)            })            .filter(|(_, te, _, neg)| *te < 0.5 || *neg >= 2)            .collect();        te_issues.sort_by(|a, b| a.1.partial_cmp(&b.1).unwrap());        if !te_issues.is_empty() {            lines.push(format!("             ?(TE < 50%):"));            for (name, te, pos, neg) in &te_issues {                lines.push(format!("    {}  ?TE={:.0}% (+{}/-{})", name, te * 100.0, pos, neg));            }        // ____________        let skill_defect_count = self.failure_log.iter()            .filter(|f| matches!(f.reflection, ReflectionType::SkillDefect)).count();        let exec_lapse_count = self.failure_log.iter()            .filter(|f| matches!(f.reflection, ReflectionType::ExecutionLapse)).count();        if !self.failure_log.is_empty() {            lines.push(format!("     :       ?{}      ={} (    } ?",                skill_defect_count, exec_lapse_count, self.failure_log.len()));        }        lines.join("")    }    /// ___________________?RPA _______?    /// trajectory: ___?"tool name(args preview)" ______?    pub fn record_trajectory(&mut self, trajectory: &[String]) {        if trajectory.is_empty() { return; }        // __?2 _________________________?        if trajectory.len() < 2 { return; }        // ___________10 ______________        let signature: String = trajectory.join("  ?");        let recent_sigs: Vec<String> = self.recent_trajectories.iter().rev().take(10).cloned().collect();        if recent_sigs.contains(&signature) {            return; // _____        }        self.recent_trajectories.push(signature);        self.trajectory_count += 1;        // ______50 ____        if self.recent_trajectories.len() > 50 {            self.recent_trajectories.drain(0..self.recent_trajectories.len() - 50);        }        println!("  [Ctx2Skill]      #{} ({} ?", self.trajectory_count, trajectory.len());    }    /// ________ RPA __________ 3 __________?    pub fn rpa_candidates(&self) -> Vec<String> {        use std::collections::HashMap;        let mut counts: HashMap<&str, usize> = HashMap::new();        for sig in &self.recent_trajectories {            *counts.entry(sig).or_insert(0) += 1;        }        counts.into_iter()            .filter(|(_, count)| *count >= 3)            .map(|(sig, count)| format!("[ {}] {}", count, sig))            .collect()    }    /// ___________________?Skill__CC TTL ___?    /// ___ confidence < 0.3 _?30_______?User _?Skill    pub fn prune(&mut self) -> Vec<String> {        let mut removed = Vec::new();        let now = chrono::Utc::now();        let now_str = now.to_rfc3339();        // _________ key____?borrow ____?        let keys_to_remove: Vec<String> = self.user_skills.iter()            .filter(|(_, skill)| {                // confidence __        if skill.confidence < 0.3 {                    return true;                }                // 30_________ last_used_at ____0___        if let Ok(last_used) = chrono::DateTime::parse_from_rfc3339(&skill.last_used_at) {                    let last_used_utc = last_used.with_timezone(&chrono::Utc);                    let days_since = (now - last_used_utc).num_days();                    if days_since > 30 && skill.usage_count > 0 {                        return true;                    }                false            })            .map(|(k, _)| k.clone())            .collect();        for key in keys_to_remove {            if let Some(skill) = self.user_skills.remove(&key) {                println!("   ?[Ctx2Skill]       ? {} (   ? {:.2},    ", skill.name, skill.confidence);                removed.push(skill.name);            }        removed    }    /// ___________ Skill__CC instinct promote ___?    /// confidence _?0.8 _?User _?Skill ____?Project _?    pub fn auto_promote(&mut self) -> Vec<String> {        let mut promoted = Vec::new();        // _________ key        let keys_to_promote: Vec<String> = self.user_skills.iter()            .filter(|(_, skill)| skill.confidence >= 0.8 && skill.usage_count >= 3)            .map(|(k, _)| k.clone())            .collect();        for key in keys_to_promote {            if let Some(mut skill) = self.user_skills.remove(&key) {                println!("    [Ctx2Skill]       ? {} (   ? {:.2}  ?Project)", skill.name, skill.confidence);                skill.layer = SkillLayer::Project;                skill.version += 1;                skill.updated_at = chrono::Utc::now().to_rfc3339();                self.project_skills.insert(skill.name.clone(), skill);                promoted.push(key);            }        promoted    }    /// _____________?Skill__USE create-evaluate-register ___?    /// _________ Skill _________?    pub fn auto_create_skill_from_trajectory(&mut self) -> Option<String> {        use std::collections::HashMap;        let mut counts: HashMap<&str, usize> = HashMap::new();        for sig in &self.recent_trajectories {            *counts.entry(sig).or_insert(0) += 1;        }        // _____ 3 ____________?Skill ____        for (sig, count) in counts.iter() {            if *count < 3 { continue; }            // _________?Skill ______________?        let skill_name = sig.split('(').next()                .unwrap_or("auto trajectory")                .replace("exec", "auto exec")                .replace("web get", "auto web");            // ___________        if self.get_skill(&skill_name).is_some() {                continue;            }            // _________?        let steps: Vec<String> = sig.split(" -> ")                .map(|s| format!("  : {}", s))                .collect();            let triggers = vec![                format!("           ( {})", count),                format!("   : {}", sig),            ];            let mut tags = vec!["auto-generated".to_string(), "trajectory".to_string()];            if sig.contains("exec") { tags.push("tool".to_string()); }            if sig.contains("web get") { tags.push("web".to_string()); }            let now = chrono::Utc::now().to_rfc3339();            let new_skill = Skill {                id: format!("auto {} {}", skill_name, count),                name: skill_name.clone(),                version: 1,                layer: SkillLayer::User,                description: format!("auto skill from {} trajectories (count: {})", skill_name, count),                index_summary: format!("     ? {} ( {})", skill_name, count),                trigger_conditions: triggers,                body_steps: steps,                body_appendix: vec![format!("created {} with {} trajectories", &now[..10], count)],                examples: Vec::new(),                tags,                quality_score: 0.6,                usage_count: 0,                created_at: now.clone(),                updated_at: now.clone(),                last_reflection: "Discovery".to_string(),                positive_uses: 0,                negative_uses: 0,                memory: SkillMemory::new(),                confidence: 0.5,                last_used_at: now,            };            let name = new_skill.name.clone();            println!("  [Ctx2Skill]         ? {} (    {}   )", name, count);            self.user_skills.insert(name.clone(), new_skill);            return Some(name);        }        None    }// __ _________ ________________________________#[derive(Debug, Clone, Serialize, Deserialize)]pub struct ConversationTurn {    pub role: String,    pub content: String,    pub timestamp: String,}#[derive(Debug, Clone, Serialize, Deserialize)]pub struct SkillVersionEntry {    pub skill_id: String,    pub version: u32,    pub skill: Skill,    pub peak_score: f64,    pub scores: Vec<f64>,    pub evaluated_at: String,}#[derive(Debug)]pub enum CrossTimeDecision {    AcceptNew,    KeepOld(Skill),    Merge,}"
